# Database (MySQL — matches prisma/schema.prisma provider)
DATABASE_URL="mysql://root:password@localhost:3306/marivo"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="MARIVO <noreply@marivo.vn>"

# Payment (abstracted - configure provider)
PAYMENT_PROVIDER=""
PAYMENT_SECRET_KEY=""
PAYMENT_MERCHANT_ID=""
PAYMENT_RETURN_URL="http://localhost:3000/payment/success"
PAYMENT_CANCEL_URL="http://localhost:3000/payment/failed"

# Storage
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MARIVO"
NEXT_PUBLIC_BUSINESS_PHONE="+84-xxx-xxx-xxx"
NEXT_PUBLIC_BUSINESS_TIMEZONE="Asia/Ho_Chi_Minh"
